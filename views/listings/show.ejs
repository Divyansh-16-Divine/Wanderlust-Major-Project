<% layout("/layouts/boilerplate") %>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>


<div class="row justify-content-center">
  <div class="col-md-8">

    <!-- Heading -->
    <h3 class="fw-bold mt-3 mb-1" style="font-size: 1.75rem;"><%= listing.title %></h3>

    <% if (listing.owner && listing.owner.username) { %>
      <p class="text-muted mb-3" style="font-size: 1rem;">
        <i class="bi bi-person-circle me-1"></i>
        Listed by <span class="fw-semibold"><%= listing.owner.username %></span>
      </p>
    <% } %>

<!-- Category with Icon -->
<% const categoryIcons = {
  "Trending": "fa-fire",
  "Rooms": "fa-person-shelter",
  "Iconic Cities": "fa-mountain-city",
  "Hill Stations": "fa-mountain",
  "Luxury Castles": "fa-brands fa-fort-awesome",
  "Amazing Pools": "fa-water-ladder",
  "Farms": "fa-tractor",
  "Campsites": "fa-tents",
  "Arctic": "fa-snowflake",
  "Beaches": "fa-umbrella-beach",
  "Others": null
}; %>


<% if (listing.category) { %>
  <p class="text-muted mb-3" style="font-size: 1rem;">
    <% if (categoryIcons[listing.category]) { %>
      <i class="fa-solid <%= categoryIcons[listing.category] %> me-1"></i>
    <% } %>
    <span class="fw-semibold"><%= listing.category %></span>
  </p>
<% } %>



    <!-- Listing Card -->
    <div class="card border-0" style="max-width: 100%;">
      <img
        src="<%= listing.image.url %>"
        class="card-img-top rounded-4 img-fluid"
        alt="listing image"
        style="max-height: 500px; width: 100%; object-fit: contain;"
      />
      <div class="card-body px-0">
        <br>
        <p class="text-muted mb-2" style="font-size: 1rem;"><%= listing.description %></p>

        <p class="mb-1">₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %></p>
        <p class="mb-1"><%= listing.location %></p>
        <p class="mb-4"><%= listing.country %></p>

        <% if (currentUser && currentUser._id.equals(listing.owner._id)){%>
        <div class="d-flex align-items-center">
          <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn px-4 py-2">Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
            <button class="btn btn-outline-dark px-4 py-2 ms-4">Delete</button>
          </form>
        </div>
        <% } %>
      </div>
    </div>

    <!-- Leave a Review Section -->
    <% if(currentUser){ %>
      <div class="mt-5">
        <hr>
        <h4 class="fw-bold mb-3">Leave a Review</h4>

        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="mb-5 needs-validation" novalidate>
          <div class="mb-3">
            <label class="form-label d-block">Rating</label>
            <fieldset class="starability-slot">
              <legend class="visually-hidden">Rate this listing:</legend>
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label">Your Comment</label>
            <textarea class="form-control" id="comment" name="review[comment]" rows="3" placeholder="Write your review here..." required></textarea>
            <div class="invalid-feedback">Please also provide Your Comment for the Review!</div>
          </div>

          <button type="submit" class="btn btn-primary">Submit Review</button>
        </form>
      </div>
    <% } %>

    <!-- All Reviews Section -->
    <h4 class="fw-bold mb-4">All Reviews</h4>

    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="row row-cols-1 row-cols-md-2 g-4">
        <% listing.reviews.forEach(review => { %>
          <div class="col">
            <div class="pt-1 px-1">
              <h6 class="fw-semibold mb-1">@<%=review.author.username%></h6>

              <div class="d-flex align-items-center mb-2" style="font-size: 0.95rem;">
                <% for (let i = 1; i <= 5; i++) { %>
                  <span class="<%= i <= review.rating ? 'text-warning' : 'text-muted' %> me-1">&#9733;</span>
                <% } %>
                <span class="text-muted ms-1" style="font-size: 0.9rem;">
                  • <%= new Date(review.createdAt).toLocaleDateString("en-IN", {
                    year: 'numeric', month: 'short', day: 'numeric'
                  }) %>
                </span>
              </div>

              <p class="mb-3" style="line-height: 1.6;"><%= review.comment %></p>

              <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                      onsubmit="return confirm('Are you sure you want to delete this review?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-muted">No reviews yet. Be the first to review!</p>
    <% } %>

    <!-- Where you'll be -->
    <div class="mt-5 mb-3">
      <h3>Where you'll be</h3>
      <div id="map"></div>
    </div>

    <script src="/js/map.js"></script>
  </div>
</div>
